//@version=6
indicator("NQ: primer extremo de la noche", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// Estrategia D. Rango de la noche: 18:00 a 9:30 hora de Nueva York.
// Cuando NY rompe primero el máximo (mínimo) de la noche, se entra a favor en la ruptura.
// SL fijo (40 pts) y se mantiene hasta las 16:00 ET, sin TP. Solo rupturas antes de las 12:30 ET.
// Gráfico recomendado: MNQ1! en 1 a 5 minutos.
tz = "America/New_York"

g1 = "Reglas"
slPts   = input.float(40.0, "Stop loss (pts)", minval=1, group=g1)
lastH   = input.int(12, "Última ruptura válida (hora ET)", minval=9, maxval=15, group=g1)
lastM   = input.int(30, "Última ruptura válida (minuto)", minval=0, maxval=59, group=g1)
exitH   = input.int(16, "Cierre (hora ET)", minval=10, maxval=16, group=g1)
useTp   = input.bool(false, "Usar TP fijo (no recomendado)", group=g1)
tpR     = input.float(2.0, "TP en R (si se usa)", minval=0.5, step=0.5, group=g1)

g2 = "Visual"
qty     = input.float(1, "Contratos", minval=1, group=g2)
ptValue = input.float(2.0, "Valor del punto ($)", tooltip="MNQ = 2, NQ = 20", group=g2)
comm    = input.float(1.24, "Comisión por contrato ($)", minval=0, group=g2)
showOn  = input.bool(true, "Dibujar rango de la noche", group=g2)
cUp     = input.color(color.new(#089981, 0), "Compra", group=g2)
cDown   = input.color(color.new(#f23645, 0), "Venta", group=g2)

tmin    = hour(time, tz) * 60 + minute(time, tz)
inNight = tmin >= 18 * 60 or tmin < 570
startN  = tmin >= 18 * 60 and (tmin[1] < 18 * 60 or na(tmin[1]))

var float onH = na
var float onL = na
var int onStart = na
var bool done = true       // ya hubo ruptura (o se descartó) en esta sesión
var int dir = 0
var float ent = na
var float sl = na
var float tp = na
var int wins = 0
var int losses = 0
var int closes = 0
var float sumUsd = 0.0

if startN
    onH := high
    onL := low
    onStart := bar_index
    done := false
else if inNight and not na(onH)
    onH := math.max(onH, high)
    onL := math.min(onL, low)

// dibujar el rango al abrir NY
if tmin >= 570 and tmin[1] < 570 and not na(onH) and showOn
    box.new(onStart, onH, bar_index, onL, border_color=color.new(color.gray, 50), bgcolor=color.new(color.gray, 92))
    line.new(bar_index, onH, bar_index + 30, onH, color=color.new(cUp, 30), style=line.style_dashed)
    line.new(bar_index, onL, bar_index + 30, onL, color=color.new(cDown, 30), style=line.style_dashed)

longSig = false
shortSig = false
if not done and dir == 0 and tmin >= 570 and tmin < lastH * 60 + lastM and not na(onH)
    upB = high > onH
    dnB = low < onL
    if upB and dnB
        done := true  // ambas en la misma vela: se descarta el día
    else if upB or dnB
        dir := upB ? 1 : -1
        ent := upB ? math.max(onH, open) : math.min(onL, open)
        sl := ent - dir * slPts
        tp := useTp ? ent + dir * tpR * slPts : na
        done := true
        longSig := upB
        shortSig := dnB
        label.new(bar_index, ent, (upB ? "COMPRA" : "VENTA") + " primer extremo @ " + str.tostring(ent, format.mintick), style=upB ? label.style_label_up : label.style_label_down, color=upB ? cUp : cDown, textcolor=color.white, size=size.small)
        line.new(bar_index, sl, bar_index + 60, sl, color=cDown, style=line.style_dashed)
        if useTp
            line.new(bar_index, tp, bar_index + 60, tp, color=cUp, style=line.style_dashed)
else if not done and tmin >= lastH * 60 + lastM and tmin < exitH * 60
    done := true

// Gestión
winSig = false
lossSig = false
closeSig = false
if dir != 0 and not (longSig or shortSig)
    float pts = na
    if dir == 1 ? low <= sl : high >= sl
        pts := -slPts
        lossSig := true
    else if useTp and (dir == 1 ? high >= tp : low <= tp)
        pts := tpR * slPts
        winSig := true
    else if tmin >= exitH * 60 and tmin < 18 * 60
        pts := (open - ent) * dir
        closeSig := true
    if not na(pts)
        sumUsd += pts * ptValue * qty - comm * qty
        if pts > 0
            wins += 1
        else
            losses += 1
        label.new(bar_index, close, (pts > 0 ? "✔ +" : "✖ ") + str.tostring(pts, "#.##") + " pts", style=label.style_label_left, color=pts > 0 ? cUp : cDown, textcolor=color.white, size=size.tiny)
        dir := 0

plotshape(longSig, "Compra", shape.triangleup, location.belowbar, cUp, size=size.small, text="BUY")
plotshape(shortSig, "Venta", shape.triangledown, location.abovebar, cDown, size=size.small, text="SELL")

var table t = table.new(position.top_right, 2, 4, bgcolor=color.new(#1e222d, 0), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast
    n = wins + losses
    table.cell(t, 0, 0, "Operaciones", text_color=color.white)
    table.cell(t, 1, 0, str.tostring(n), text_color=color.white)
    table.cell(t, 0, 1, "Ganadoras", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(wins) + (n > 0 ? " (" + str.tostring(100.0 * wins / n, "#") + "%)" : ""), text_color=cUp)
    table.cell(t, 0, 2, "Neto $", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(sumUsd, "#,###.##"), text_color=sumUsd >= 0 ? cUp : cDown)
    table.cell(t, 0, 3, "Hoy", text_color=color.white)
    table.cell(t, 1, 3, dir == 1 ? "Comprado" : dir == -1 ? "Vendido" : done ? "Sin operación pendiente" : "Esperando ruptura", text_color=color.yellow)

if longSig or shortSig
    alert("NQ primer extremo de la noche: " + (longSig ? "COMPRA" : "VENTA") + " en " + str.tostring(ent, format.mintick) + " · SL " + str.tostring(sl, format.mintick) + " · mantener hasta las 16:00 ET", alert.freq_once_per_bar)
if lossSig or closeSig or winSig
    alert("NQ primer extremo de la noche: " + (lossSig ? "SL tocado" : closeSig ? "cerrar posición (16:00 ET)" : "TP"), alert.freq_once_per_bar)
alertcondition(longSig or shortSig, "Entrada primer extremo", "NQ: ruptura del primer extremo de la noche")
alertcondition(closeSig, "Cierre 16:00 ET", "NQ: cerrar la posición del primer extremo")
