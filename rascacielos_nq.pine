//@version=6
indicator("Rascacielos NQ (9:30 NY)", overlay=true, max_lines_count=500, max_labels_count=500)

// Estrategia "Rascacielos": entrada a la apertura de NY (9:30 ET) a favor de la EMA 20/50 de 15 min,
// TP chico, SL grande y promediado opcional en contra. Cierre 15:55 ET si no toca nada.
// Ojo: en el backtest 2024-2026 (backtest/rascacielos*.py) ninguna versión tuvo ventaja; úsalo para seguirla, no como plan.
// Usar en MNQ1!/NQ1! en 1, 2, 3 o 5 minutos.

tzNY = "America/New_York"
g1 = "Reglas"
modo   = input.string("A favor de las EMAs", "Dirección", options=["A favor de las EMAs", "Al revés"], group=g1)
tpPts  = input.float(10, "TP (pts desde el precio promedio)", minval=0.25, step=0.25, group=g1)
slPts  = input.float(700, "SL (pts desde la primera entrada)", minval=1, step=0.25, group=g1)
promed = input.string("Sin promediar", "Promediado en contra", options=["Sin promediar", "2 iguales (+1 a 1/3 y 2/3 del SL)", "Martingala (+2 a 1/3, +4 a 2/3)"], group=g1)
qty0   = input.int(1, "Contratos iniciales", minval=1, group=g1)
pv     = input.float(2.0, "$ por punto por contrato (MNQ = 2, NQ = 20)", minval=0.01, group=g1)
eH     = input.int(9, "Hora de entrada (NY)", minval=0, maxval=23, group=g1)
eM     = input.int(30, "Minuto de entrada (NY)", minval=0, maxval=59, group=g1)
cH     = input.int(15, "Hora de cierre (NY)", minval=0, maxval=23, group=g1)
cM     = input.int(55, "Minuto de cierre (NY)", minval=0, maxval=59, group=g1)
showEma = input.bool(true, "Mostrar EMA 20 y 50 de 15 min", group="Vista")
cUp   = input.color(color.new(#089981, 0), "Compra", group="Vista")
cDown = input.color(color.new(#f23645, 0), "Venta", group="Vista")

// EMAs de 15 min, solo velas cerradas (sin repintar)
e20 = request.security(syminfo.tickerid, "15", ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
e50 = request.security(syminfo.tickerid, "15", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
plot(showEma ? e20 : na, "EMA 20 (15m)", color=color.new(color.orange, 20))
plot(showEma ? e50 : na, "EMA 50 (15m)", color=color.new(color.blue, 20))

tNY = hour(time, tzNY) * 60 + minute(time, tzNY)
entryMin = eH * 60 + eM
closeMin = cH * 60 + cM
newDay = dayofmonth(time, tzNY) != dayofmonth(time[1], tzNY)

// Niveles de promediado: [fracción del SL, contratos extra por cada contrato inicial]
f1 = 1.0 / 3.0
f2 = 2.0 / 3.0
add1 = promed == "Sin promediar" ? 0 : promed == "2 iguales (+1 a 1/3 y 2/3 del SL)" ? 1 : 2
add2 = promed == "Sin promediar" ? 0 : promed == "2 iguales (+1 a 1/3 y 2/3 del SL)" ? 1 : 4

var int side = 0
var bool done = false
var float e0 = na
var float slLvl = na
var float a1Lvl = na
var float a2Lvl = na
var int qty = 0
var float avg = na
var bool did1 = false
var bool did2 = false
var line lTp = na
var line lSl = na
var line lA1 = na
var line lA2 = na
var int wins = 0
var int losses = 0
var float net = 0.0
var string estado = "Esperando 9:30 NY"

if newDay
    side := 0
    done := false
    qty := 0
    estado := "Esperando 9:30 NY"

closeTrade(float px, string why) =>
    pnl = (px - avg) * side * qty * pv - 1.74 * qty
    label.new(bar_index, px, why + (pnl >= 0 ? " +$" : " −$") + str.tostring(math.abs(pnl), "#,###.##") + "\n" + str.tostring(qty) + " contratos", style=label.style_label_left, color=pnl >= 0 ? color.new(cUp, 20) : color.new(cDown, 20), textcolor=color.white, size=size.small)
    pnl

// Entrada a la apertura de la vela de las 9:30 NY
if not done and side == 0 and tNY == entryMin and not na(e20) and not na(e50) and e20 != e50
    dirEma = e20 > e50 ? 1 : -1
    side := modo == "A favor de las EMAs" ? dirEma : -dirEma
    e0 := open
    qty := qty0
    avg := open
    did1 := false
    did2 := false
    slLvl := e0 - side * slPts
    a1Lvl := add1 > 0 ? e0 - side * f1 * slPts : na
    a2Lvl := add2 > 0 ? e0 - side * f2 * slPts : na
    estado := (side == 1 ? "COMPRA" : "VENTA") + " abierta"
    label.new(bar_index, e0, (side == 1 ? "▲ COMPRA" : "▼ VENTA") + " 9:30\nEntrada " + str.tostring(e0, format.mintick) + "\nTP " + str.tostring(e0 + side * tpPts, format.mintick) + "   SL " + str.tostring(slLvl, format.mintick), style=side == 1 ? label.style_label_up : label.style_label_down, color=side == 1 ? cUp : cDown, textcolor=color.white)
    lTp := line.new(bar_index, e0 + side * tpPts, bar_index + 1, e0 + side * tpPts, color=cUp, style=line.style_dashed, extend=extend.right)
    lSl := line.new(bar_index, slLvl, bar_index + 1, slLvl, color=cDown, style=line.style_dashed, extend=extend.right)
    if add1 > 0
        lA1 := line.new(bar_index, a1Lvl, bar_index + 1, a1Lvl, color=color.new(color.gray, 30), style=line.style_dotted, extend=extend.right)
        lA2 := line.new(bar_index, a2Lvl, bar_index + 1, a2Lvl, color=color.new(color.gray, 30), style=line.style_dotted, extend=extend.right)
    alert("Rascacielos: " + (side == 1 ? "COMPRA" : "VENTA") + " " + str.tostring(qty0) + " a mercado " + str.tostring(e0, format.mintick) + " · TP " + str.tostring(e0 + side * tpPts, format.mintick) + " · SL " + str.tostring(slLvl, format.mintick), alert.freq_once_per_bar)

// Gestión de la posición
inPos = side != 0 and not done
if inPos
    worst = side == 1 ? low : high
    best = side == 1 ? high : low
    // promediado
    if add1 > 0 and not did1 and (side == 1 ? low <= a1Lvl : high >= a1Lvl)
        avg := (avg * qty + a1Lvl * add1 * qty0) / (qty + add1 * qty0)
        qty := qty + add1 * qty0
        did1 := true
        line.set_y1(lTp, avg + side * tpPts)
        line.set_y2(lTp, avg + side * tpPts)
        alert("Rascacielos: promedia +" + str.tostring(add1 * qty0) + " en " + str.tostring(a1Lvl, format.mintick) + " · nuevo TP " + str.tostring(avg + side * tpPts, format.mintick), alert.freq_once_per_bar)
    if add2 > 0 and not did2 and (side == 1 ? low <= a2Lvl : high >= a2Lvl)
        avg := (avg * qty + a2Lvl * add2 * qty0) / (qty + add2 * qty0)
        qty := qty + add2 * qty0
        did2 := true
        line.set_y1(lTp, avg + side * tpPts)
        line.set_y2(lTp, avg + side * tpPts)
        alert("Rascacielos: promedia +" + str.tostring(add2 * qty0) + " en " + str.tostring(a2Lvl, format.mintick) + " · nuevo TP " + str.tostring(avg + side * tpPts, format.mintick), alert.freq_once_per_bar)
    tpLvl = avg + side * tpPts
    float res = na
    if tNY >= closeMin
        res := closeTrade(open, "Cierre 15:55")
    else if side == 1 ? low <= slLvl : high >= slLvl
        res := closeTrade(slLvl, "SL")
    else if side == 1 ? high >= tpLvl : low <= tpLvl
        res := closeTrade(tpLvl, "TP")
    if not na(res)
        net += res
        wins += res > 0 ? 1 : 0
        losses += res > 0 ? 0 : 1
        done := true
        estado := (res > 0 ? "Ganada " : "Perdida ") + (res >= 0 ? "+$" : "−$") + str.tostring(math.abs(res), "#,###")
        line.set_extend(lTp, extend.none)
        line.set_x2(lTp, bar_index)
        line.set_extend(lSl, extend.none)
        line.set_x2(lSl, bar_index)
        if add1 > 0
            line.set_extend(lA1, extend.none)
            line.set_x2(lA1, bar_index)
            line.set_extend(lA2, extend.none)
            line.set_x2(lA2, bar_index)
        alert("Rascacielos: cerrada " + estado, alert.freq_once_per_bar)

// Tabla
var table tb = table.new(position.top_right, 2, 6, bgcolor=color.new(#1e222d, 0), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast
    dirNow = na(e20) or na(e50) ? "—" : (modo == "A favor de las EMAs" ? (e20 > e50 ? "COMPRA" : "VENTA") : (e20 > e50 ? "VENTA" : "COMPRA"))
    table.cell(tb, 0, 0, "Rascacielos hoy", text_color=color.white, text_halign=text.align_left)
    table.cell(tb, 1, 0, estado, text_color=color.yellow)
    table.cell(tb, 0, 1, "Dirección según EMAs", text_color=color.white, text_halign=text.align_left)
    table.cell(tb, 1, 1, dirNow, text_color=color.white)
    table.cell(tb, 0, 2, "Contratos ahora / precio prom.", text_color=color.white, text_halign=text.align_left)
    table.cell(tb, 1, 2, inPos ? str.tostring(qty) + " / " + str.tostring(avg, format.mintick) : "—", text_color=color.white)
    table.cell(tb, 0, 3, "Ganadas / perdidas", text_color=color.white, text_halign=text.align_left)
    table.cell(tb, 1, 3, str.tostring(wins) + " / " + str.tostring(losses), text_color=color.white)
    table.cell(tb, 0, 4, "Neto $ (en el gráfico)", text_color=color.white, text_halign=text.align_left)
    table.cell(tb, 1, 4, str.tostring(net, "#,###.##"), text_color=net >= 0 ? cUp : cDown)
    table.cell(tb, 0, 5, "Pérdida máx. posible por día", text_color=color.white, text_halign=text.align_left)
    table.cell(tb, 1, 5, "$" + str.tostring(slPts * pv * qty0 * (1 + add1 * f2 + add2 * f1), "#,###"), text_color=cDown)

alertcondition(side != 0 and not done and tNY == entryMin, "Entrada Rascacielos", "Rascacielos: entrada 9:30 NY")
