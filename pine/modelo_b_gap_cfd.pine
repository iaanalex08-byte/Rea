// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Modelo B · Gap · versión CFD US500
// Se pone en el gráfico del CFD (US500, SPX500, etc.) en velas de 3 minutos.
// Los filtros salen de ES1! (volumen real): EMA 20 de 3 min, A, C, sin BOS en contra, VWAP a favor y gap no en contra.
// Las cajas se dibujan en el precio del CFD, en puntos desde tu entrada: SL 8.75 · TP1 8.75 (mitad) · TP2 30 (otra mitad).
//@version=6
indicator("Modelo B · Gap · CFD US500 · señal de ES1!", shorttitle = "MB Gap CFD", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500, calc_bars_count = 20000)

// ───────────── Entradas ─────────────
const string TZ = "America/New_York"

string gSig   = "Señal (se calcula con ES)"
string esSym  = input.symbol("CME_MINI:ES1!", "Símbolo de ES para la señal", group = gSig)
int    hEnt   = input.int(10, "Hora de entrada (NY)",   minval = 0, maxval = 23, group = gSig)
int    mEnt   = input.int(12, "Minuto de entrada (NY)", minval = 0, maxval = 59, group = gSig)
int    lenEma = input.int(20, "EMA de 3 min", minval = 1, group = gSig)

string gFi    = "Filtros"
bool   useA   = input.bool(true, "A: fuera del área de valor de ayer", group = gFi)
float  vaPct  = input.float(70, "Área de valor (% del volumen)", minval = 50, maxval = 95, group = gFi)
bool   useC   = input.bool(true, "C: perfil de hoy no ya a favor (P / b)", group = gFi)
float  cFrac  = input.float(0.38, "C: fracción para P / b", minval = 0.05, maxval = 0.5, step = 0.01, group = gFi)
bool   useBos = input.bool(true, "Sin BOS en contra", group = gFi)
int    bosMin = input.int(60, "BOS: ventana (minutos)", minval = 15, group = gFi)
bool   useVw  = input.bool(true, "VWAP del día a favor", group = gFi)
bool   useGap = input.bool(true, "Gap de apertura no en contra", group = gFi)
float  gapMax = input.float(8.0, "Gap máximo en contra (pts de ES)", minval = 0, step = 0.25, group = gFi)
bool   skipFM = input.bool(false, "Opcional: no operar en febrero ni marzo", group = gFi)

string gBr   = "Bracket en el CFD (puntos)"
float  slPts = input.float(8.75, "Stop (todo)",      minval = 0.1, step = 0.25, group = gBr)
float  t1Pts = input.float(8.75, "TP1 (mitad)",      minval = 0.1, step = 0.25, group = gBr)
float  t2Pts = input.float(30.0, "TP2 (otra mitad)", minval = 0.1, step = 0.25, group = gBr)
bool   useBE = input.bool(true, "Stop a break-even al tocar TP1", group = gBr)
int    hCl   = input.int(15, "Cierre forzado: hora (NY)",   minval = 0, maxval = 23, group = gBr)
int    mCl   = input.int(59, "Cierre forzado: minuto (NY)", minval = 0, maxval = 59, group = gBr)

string gCu    = "Tu cuenta y tu broker"
float  spread = input.float(0.5, "Spread del CFD a las 10:12 (pts)", minval = 0, step = 0.05, group = gCu)
float  vpp    = input.float(1.0, "$ por punto con 1 lote", minval = 0.0001, step = 0.01, group = gCu)
float  minLot = input.float(0.01, "Lote mínimo", minval = 0.0001, step = 0.01, group = gCu)
float  capital = input.float(100, "Capital ($)", minval = 1, group = gCu)
float  riskPct = input.float(2.0, "Riesgo por operación (% del capital)", minval = 0.1, maxval = 50, step = 0.1, group = gCu)
float  maxSpread = input.float(1.0, "No operar si el spread pasa de (pts)", minval = 0, step = 0.05, group = gCu)

string gVi      = "Visual"
bool   showSkip = input.bool(true, "Marcar días descartados", group = gVi)
bool   showTbl  = input.bool(true, "Mostrar tabla", group = gVi)
color  cUp  = input.color(#1FAE89, "Compra / ganancia", group = gVi)
color  cDn  = input.color(#E2582F, "Venta / pérdida", group = gVi)
color  cTP  = input.color(color.new(#1FAE89, 82), "Relleno caja TP", group = gVi)
color  cSL  = input.color(color.new(#E2582F, 82), "Relleno caja SL", group = gVi)

// ───────────── Utilidades (se ejecutan sobre ES) ─────────────
nyMin(int t) => hour(t, TZ) * 60 + minute(t, TZ)

addVol(map<int, float> m, float h, float l, float v, float tk) =>
    int a = math.round(l / tk)
    int b = math.round(h / tk)
    float per = nz(v) / (b - a + 1)
    for k = a to b
        m.put(k, nz(m.get(k)) + per)
    m.size()

valueArea(map<int, float> m, float frac, float tk) =>
    float vah = na
    float val = na
    array<int> ks = m.keys()
    int n = ks.size()
    if n > 0
        ks.sort(order.ascending)
        array<float> vs = array.new<float>(n, 0.0)
        float tot = 0.0
        float best = -1.0
        int pi = 0
        for i = 0 to n - 1
            float v = m.get(ks.get(i))
            vs.set(i, v)
            tot += v
            if v > best
                best := v
                pi := i
        int lo = pi
        int hi = pi
        float acc = best
        while acc < frac * tot and (lo > 0 or hi < n - 1)
            float up = hi < n - 1 ? vs.get(hi + 1) : -1.0
            float dn = lo > 0 ? vs.get(lo - 1) : -1.0
            if up >= dn
                hi += 1
                acc += up
            else
                lo -= 1
                acc += dn
        vah := ks.get(hi) * tk
        val := ks.get(lo) * tk
    [vah, val]

pocPosition(map<int, float> m, float hi, float lo, float tk) =>
    float res = 0.5
    array<int> ks = m.keys()
    int n = ks.size()
    if n > 0 and hi > lo
        ks.sort(order.ascending)
        float best = -1.0
        int bk = ks.get(0)
        for i = 0 to n - 1
            int k = ks.get(i)
            float v = m.get(k)
            if v > best
                best := v
                bk := k
        res := (bk * tk - lo) / (hi - lo)
    res

bosAgainst(int dir, int n) =>
    bool found = false
    float lvl = na
    int sj = 0
    for k = 0 to n - 1
        int j = k - 2
        if j - 2 >= 0
            float rj = dir > 0 ? low[n - j] : high[n - j]
            bool isSw = true
            for q = j - 2 to j + 2
                if q != j
                    float rq = dir > 0 ? low[n - q] : high[n - q]
                    if dir > 0 ? rj >= rq : rj <= rq
                        isSw := false
            if isSw
                lvl := rj
                sj := j
        if not found and not na(lvl) and k > sj + 2
            float c = close[n - k]
            if dir > 0 ? c < lvl : c > lvl
                found := true
    found

// Señal completa calculada en las velas de ES. En la vela que abre a la hora de entrada devuelve la dirección
// (1 compra, −1 venta) y el estado de cada filtro, usando solo velas ya cerradas. En las demás velas devuelve 0.
esSignal() =>
    float tk = syminfo.mintick
    var map<int, float> prof = map.new<int, float>()
    var float yVAH = na
    var float yVAL = na
    var float lastRthClose = na
    var float prevClose = na
    var float rthOpen = na
    var float hiT = na
    var float loT = na
    var float pvSum = 0.0
    var float vSum = 0.0
    float e3 = ta.ema(close, lenEma)
    int bN = math.max(5, int(math.floor(bosMin * 60.0 / timeframe.in_seconds())))
    int mO = nyMin(time)
    int dN = dayofmonth(time, TZ)
    int dw = dayofweek(time, TZ)
    bool rth = dw >= dayofweek.monday and dw <= dayofweek.friday and mO >= 570 and mO < 960
    bool rthS = rth and (not rth[1] or dN != dN[1])
    if rthS
        if prof.size() > 0
            [a, b] = valueArea(prof, vaPct / 100, tk)
            yVAH := a
            yVAL := b
        prevClose := lastRthClose
        rthOpen := open
        prof.clear()
        hiT := na
        loT := na
        pvSum := 0.0
        vSum := 0.0
    int   d    = 0
    bool  okA  = false
    bool  okC  = false
    bool  okB  = false
    bool  okV  = false
    bool  okG  = false
    float gap  = na
    float pos  = na
    if rth and mO == hEnt * 60 + mEnt
        float px = close[1]
        float em = e3[1]
        d := px > em ? 1 : px < em ? -1 : 0
        if d != 0
            float vw = vSum > 0 ? pvSum / vSum : na
            okA := not na(yVAH) and (px > yVAH or px < yVAL)
            pos := pocPosition(prof, hiT, loT, tk)
            okC := d > 0 ? pos < 1 - cFrac : pos > cFrac
            okB := not bosAgainst(d, bN)   // solo se calcula a la hora de entrada
            okV := not na(vw) and (d > 0 ? px > vw : px < vw)
            gap := d * (rthOpen - prevClose)
            okG := not na(gap) and gap > -gapMax
    if rth
        addVol(prof, high, low, volume, tk)
        hiT := na(hiT) ? high : math.max(hiT, high)
        loT := na(loT) ? low : math.min(loT, low)
        pvSum += hlc3 * volume
        vSum  += volume
        lastRthClose := close
    [d, okA, okC, okB, okV, okG, gap, pos]

okTxt(bool used, bool ok) => used ? (ok ? "✓" : "✕") : "–"

// ───────────── Señal de ES en el gráfico del CFD ─────────────
[eDir, eA, eC, eB, eV, eG, eGap, ePos] = request.security(esSym, timeframe.period, esSignal())

int   tfSec    = timeframe.in_seconds()
int   mOpen    = nyMin(time)
int   dNy      = dayofmonth(time, TZ)
bool  isSignal = mOpen == hEnt * 60 + mEnt and nz(eDir) != 0
int   tEnd     = timestamp(TZ, year(time, TZ), month(time, TZ), dNy, hCl, mCl)

// Tamaño: lote para arriesgar el % elegido con el stop más el spread
float riesgoUsd = capital * riskPct / 100
float stopCost  = slPts + spread
float lotRaw    = riesgoUsd / (stopCost * vpp)
float lots      = math.floor(lotRaw / minLot + 1e-9) * minLot
bool  canSplit  = lots / 2 >= minLot - 1e-9

// ───────────── Operación en el CFD ─────────────
var int   tDir   = 0
var bool  active = false
var bool  tp1Hit = false
var float tEntry = na
var float tStop  = na
var float tTP1   = na
var float tTP2   = na
var int   tClose = 0
var box   bxTP   = na
var box   bxSL   = na
var line  lnTP1  = na

var int   nOps  = 0
var int   nWin  = 0
var float gWin  = 0.0
var float gLoss = 0.0
var float neto  = 0.0

var string sFecha = "—"
var string sDir   = "—"
var string sA     = "—"
var string sC     = "—"
var string sBos   = "—"
var string sVw    = "—"
var string sGap   = "—"
var string sVer   = "Esperando 10:12"
var color  cVer   = color.gray

bool evLong  = false
bool evShort = false
bool evSkip  = false
bool evTp1   = false
bool evExit  = false

if isSignal and not active
    int   d     = int(eDir)
    float px    = close[1]
    int   mesNy = month(time, TZ)
    bool  okMes = not (skipFM and (mesNy == 2 or mesNy == 3))
    bool  okSp  = spread <= maxSpread
    bool  pasa  = (not useA or eA) and (not useC or eC) and (not useBos or eB) and (not useVw or eV) and (not useGap or eG) and okMes and okSp and lots > 0

    sFecha := str.format_time(time, "dd/MM/yyyy", TZ)
    sDir   := d > 0 ? "Compra" : "Venta"
    sA     := okTxt(useA, eA)
    sC     := okTxt(useC, eC) + (na(ePos) ? "" : str.format("  POC al {0,number,#}%", ePos * 100))
    sBos   := okTxt(useBos, eB)
    sVw    := okTxt(useVw, eV)
    sGap   := okTxt(useGap, eG) + (na(eGap) ? "" : str.format("  {0}{1,number,#.##} pts", eGap >= 0 ? "+" : "", eGap))

    if pasa
        tDir   := d
        active := true
        tp1Hit := false
        tEntry := px
        tStop  := px - d * slPts
        tTP1   := px + d * t1Pts
        tTP2   := px + d * t2Pts
        tClose := tEnd
        bxTP  := box.new(time, math.max(tEntry, tTP2), tEnd, math.min(tEntry, tTP2), xloc = xloc.bar_time,
             border_color = color.new(cUp, 40), bgcolor = cTP,
             text = "TP2 " + str.tostring(tTP2, format.mintick), text_color = cUp, text_size = size.small,
             text_halign = text.align_right, text_valign = d > 0 ? text.align_top : text.align_bottom)
        bxSL  := box.new(time, math.max(tEntry, tStop), tEnd, math.min(tEntry, tStop), xloc = xloc.bar_time,
             border_color = color.new(cDn, 40), bgcolor = cSL,
             text = "SL " + str.tostring(tStop, format.mintick), text_color = cDn, text_size = size.small,
             text_halign = text.align_right, text_valign = d > 0 ? text.align_bottom : text.align_top)
        lnTP1 := line.new(time, tTP1, tEnd, tTP1, xloc = xloc.bar_time, color = cUp, style = line.style_dashed, width = 1)
        label.new(tEnd, tTP1, "TP1 " + str.tostring(tTP1, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
             color = color.new(color.black, 100), textcolor = cUp, size = size.small)
        label.new(time, tEntry, str.format("{0} {1}\n{2} lotes", d > 0 ? "COMPRA" : "VENTA", str.tostring(tEntry, format.mintick), lots),
             xloc = xloc.bar_time, style = d > 0 ? label.style_label_up : label.style_label_down, yloc = d > 0 ? yloc.belowbar : yloc.abovebar,
             color = d > 0 ? cUp : cDn, textcolor = color.white, size = size.small)
        sVer := "Se opera: " + sDir
        cVer := d > 0 ? cUp : cDn
        evLong  := d > 0
        evShort := d < 0
        alert(str.format("MB Gap CFD: {0} {1} a {2}. {3} lotes. SL {4} · TP1 {5} · TP2 {6}", sDir, syminfo.ticker,
             str.tostring(tEntry, format.mintick), lots, str.tostring(tStop, format.mintick),
             str.tostring(tTP1, format.mintick), str.tostring(tTP2, format.mintick)), alert.freq_once_per_bar)
    else
        string why = ""
        why += useA and not eA ? " A" : ""
        why += useC and not eC ? " C" : ""
        why += useBos and not eB ? " BOS" : ""
        why += useVw and not eV ? " VWAP" : ""
        why += useGap and not eG ? " Gap" : ""
        why += not okMes ? " Feb/Mar" : ""
        why += not okSp ? " Spread" : ""
        why += lots <= 0 ? " Lote" : ""
        sVer := "No se opera:" + why
        cVer := color.gray
        evSkip := true
        if showSkip
            label.new(time, close[1], "✕" + why, xloc = xloc.bar_time, yloc = d > 0 ? yloc.belowbar : yloc.abovebar,
                 style = d > 0 ? label.style_label_up : label.style_label_down,
                 color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)

// Seguimiento del bracket vela por vela (si en la misma vela se tocan stop y objetivo, cuenta el stop). Resultados en puntos.
if active
    string out = ""
    float p1 = na
    float p2 = na
    bool adv = tDir > 0 ? low <= tStop : high >= tStop
    bool f1  = tDir > 0 ? high >= tTP1 : low <= tTP1
    bool f2  = tDir > 0 ? high >= tTP2 : low <= tTP2
    float stopP = tDir * (tStop - tEntry)
    if not tp1Hit
        if adv
            out := "Stop"
            p1 := stopP
            p2 := stopP
        else if f1
            tp1Hit := true
            evTp1  := true
            if f2
                out := "TP1 + TP2"
                p1 := t1Pts
                p2 := t2Pts
            else if useBE
                tStop := tEntry
                box.set_top(bxSL, tEntry)
                box.set_bottom(bxSL, tEntry)
                box.set_text(bxSL, "")
                line.new(time, tEntry, tClose, tEntry, xloc = xloc.bar_time, color = color.gray, style = line.style_dotted)
    else
        if adv
            out := stopP >= 0 ? "TP1 + break-even" : "TP1 + stop"
            p1 := t1Pts
            p2 := stopP
        else if f2
            out := "TP1 + TP2"
            p1 := t1Pts
            p2 := t2Pts
    if out == "" and time_close >= tClose
        float lt = tDir * (close - tEntry)
        out := tp1Hit ? "TP1 + cierre 15:59" : "Cierre 15:59"
        p1 := tp1Hit ? t1Pts : lt
        p2 := lt
    if out != ""
        active := false
        evExit := true
        box.set_right(bxTP, time_close)
        box.set_right(bxSL, time_close)
        line.set_x2(lnTP1, time_close)
        float ptsNet = (p1 + p2) / 2 - spread
        float usd = lots * vpp * ptsNet
        nOps += 1
        neto += usd
        if usd > 0
            nWin += 1
            gWin += usd
        else
            gLoss -= usd
        sVer := out + str.format("  {0}{1,number,#.##} pts", ptsNet >= 0 ? "+" : "", ptsNet)
        cVer := usd > 0 ? cUp : cDn
        label.new(time_close, tDir > 0 ? high : low, out + "\n" + str.format("{0}{1,number,#.##} pts", ptsNet >= 0 ? "+" : "", ptsNet),
             xloc = xloc.bar_time, style = tDir > 0 ? label.style_label_down : label.style_label_up,
             color = usd > 0 ? cUp : cDn, textcolor = color.white, size = size.tiny)

// ───────────── Tabla ─────────────
var table tb = table.new(position.top_right, 2, 16, bgcolor = color.new(#0F1112, 10), border_color = color.new(color.white, 85), border_width = 1)
if showTbl and barstate.islast
    color tx = color.white
    color mu = color.new(color.white, 40)
    bool tfBad = tfSec != 180
    table.cell(tb, 0, 0, tfBad ? "MB Gap CFD · usa velas de 3 min" : "MB Gap CFD · señal de " + esSym, text_color = tfBad ? color.yellow : tx, text_size = size.small)
    table.cell(tb, 1, 0, sFecha, text_color = mu, text_size = size.small)
    table.cell(tb, 0, 1, "Señal EMA (ES)", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 1, sDir, text_color = tx, text_size = size.small)
    table.cell(tb, 0, 2, "A fuera del valor", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 2, sA, text_color = tx, text_size = size.small)
    table.cell(tb, 0, 3, "C perfil", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 3, sC, text_color = tx, text_size = size.small)
    table.cell(tb, 0, 4, "Sin BOS en contra", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 4, sBos, text_color = tx, text_size = size.small)
    table.cell(tb, 0, 5, "VWAP a favor", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 5, sVw, text_color = tx, text_size = size.small)
    table.cell(tb, 0, 6, "Gap no en contra (ES)", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 6, sGap, text_color = tx, text_size = size.small)
    table.cell(tb, 0, 7, "Resultado", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 7, sVer, text_color = color.white, bgcolor = color.new(cVer, 40), text_size = size.small)
    table.cell(tb, 0, 8, "Tamaño", text_color = tx, text_size = size.small)
    table.cell(tb, 1, 8, "", text_size = size.small)
    table.cell(tb, 0, 9, str.format("Riesgo {0,number,#.#}% de ${1,number,#,###}", riskPct, capital), text_color = mu, text_size = size.small)
    table.cell(tb, 1, 9, str.format("${0,number,#.##} por operación", riesgoUsd), text_color = tx, text_size = size.small)
    table.cell(tb, 0, 10, "Lotes a abrir", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 10, lots > 0 ? str.format("{0} ({1} a TP1 · {1} a TP2)", lots, lots / 2) + (canSplit ? "" : "  ⚠ no se puede partir") : "No alcanza el lote mínimo", text_color = lots > 0 and canSplit ? tx : color.yellow, text_size = size.small)
    table.cell(tb, 0, 11, "Spread", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 11, str.format("{0,number,#.##} pts", spread) + (spread > maxSpread ? "  ⚠ demasiado alto" : ""), text_color = spread > maxSpread ? color.yellow : tx, text_size = size.small)
    table.cell(tb, 0, 12, "En este gráfico", text_color = tx, text_size = size.small)
    table.cell(tb, 1, 12, str.format("{0} ops · {1}", nOps, nOps > 0 ? str.format("{0,number,#.#}% ganadas", 100.0 * nWin / nOps) : "—"), text_color = tx, text_size = size.small)
    table.cell(tb, 0, 13, "Factor de beneficio", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 13, gLoss > 0 ? str.format("{0,number,#.##}", gWin / gLoss) : "—", text_color = tx, text_size = size.small)
    table.cell(tb, 0, 14, "Neto con spread", text_color = mu, text_size = size.small)
    table.cell(tb, 1, 14, str.format("{0}${1,number,#,###.##}", neto >= 0 ? "+" : "-", math.abs(neto)), text_color = neto >= 0 ? cUp : cDn, text_size = size.small)

// ───────────── Alertas ─────────────
alertcondition(evLong,  "MB Gap CFD · Compra",      "MB Gap CFD: COMPRA a las 10:12 NY en {{ticker}}; pasan los filtros de ES")
alertcondition(evShort, "MB Gap CFD · Venta",       "MB Gap CFD: VENTA a las 10:12 NY en {{ticker}}; pasan los filtros de ES")
alertcondition(evSkip,  "MB Gap CFD · No se opera", "MB Gap CFD: hoy no se opera en {{ticker}}")
alertcondition(evTp1,   "MB Gap CFD · TP1",         "MB Gap CFD: TP1 tocado en {{ticker}}; stop del resto a break-even")
alertcondition(evExit,  "MB Gap CFD · Salida",      "MB Gap CFD: la operación de hoy cerró en {{ticker}}")
