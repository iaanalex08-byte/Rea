// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Modelo B · ES · entrada 9:12 hora de Ciudad de México
// SL 35 ticks · TP1 30 ticks (contrato 1) · TP2 120 ticks (contrato 2) · break-even tras TP1 · cierre 15:59 Nueva York
// Bracket 35/30/120: el único con PF > 1 en 2023, 2024, 2025 y 2026 con EMA 20 de 3 min + A + C (ver backtest/cuatro_anios.py).
// El bracket anterior era 45/30/60; se puede volver a él en la configuración.
// Filtros de perfil (ver backtest/analisis_perfil.py): A = saltar si la entrada cae dentro del área de valor de ayer,
// C = saltar si el perfil del día ya es P (en compras) o b (en ventas). El perfil se arma por tiempo (TPO) con las velas del gráfico.
// Úsalo en un gráfico de 1 minuto para que coincida con el backtest.
//@version=6
indicator("Modelo B · ES 9:12 CDMX · SL 35 · TP1 30 · TP2 120", shorttitle = "Modelo B", overlay = true, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

// ───────────── Entradas ─────────────
const string TZ_MX = "America/Mexico_City"
const string TZ_NY = "America/New_York"

string gEnt  = "Entrada"
int    hEnt  = input.int(9,  "Hora de entrada (CDMX)",   minval = 0, maxval = 23, group = gEnt)
int    mEnt  = input.int(12, "Minuto de entrada (CDMX)", minval = 0, maxval = 59, group = gEnt)
string tfEma = input.timeframe("3", "Marco de la EMA", group = gEnt)
int    lenEma = input.int(20, "Periodo de la EMA", minval = 1, group = gEnt)
int    preMin = input.int(5, "Aviso previo (minutos antes de la entrada)", minval = 1, maxval = 60, group = gEnt)
bool   showPre = input.bool(true, "Mostrar flecha de aviso previo", group = gEnt)

string gBr  = "Bracket (ticks)"
int    slT  = input.int(35, "Stop loss",          minval = 1, group = gBr)
int    tp1T = input.int(30, "TP1 (contrato 1)",   minval = 1, group = gBr)
int    tp2T = input.int(120, "TP2 (contrato 2)",   minval = 1, group = gBr)
bool   useBE = input.bool(true, "Stop a break-even al tocar TP1", group = gBr)

string gCl = "Cierre forzado (hora de Nueva York)"
int    hCl = input.int(15, "Hora",   minval = 0, maxval = 23, group = gCl)
int    mCl = input.int(59, "Minuto", minval = 0, maxval = 59, group = gCl)

string gCo  = "Costos para las estadísticas"
int    qty  = input.int(1, "Contratos por pierna (2 piernas)", minval = 1, group = gCo)
float  comm = input.float(4.5, "Comisión ida y vuelta por contrato (USD)", minval = 0, step = 0.25, group = gCo)
float  slip = input.float(1.0, "Deslizamiento por contrato (ticks)", minval = 0, step = 0.5, group = gCo)

string gVi       = "Visual"
bool   showEma   = input.bool(true, "Mostrar EMA", group = gVi)
bool   showTable = input.bool(true, "Mostrar tabla de estadísticas", group = gVi)
color  cUp   = input.color(#1FAE89, "Color compra / ganancia", group = gVi)
color  cDn   = input.color(#E2582F, "Color venta / pérdida", group = gVi)

string gPf    = "Perfil de mercado (filtros A y C)"
bool   useA   = input.bool(true, "Filtro A: saltar si la entrada cae dentro del área de valor de ayer", group = gPf)
bool   useC   = input.bool(true, "Filtro C: saltar si el perfil del día ya es P (compra) o b (venta)", group = gPf)
string fMode  = input.string("Saltar", "Entradas filtradas", options = ["Saltar", "Solo marcar"], group = gPf,
     tooltip = "Saltar: no se abre la operación y no cuenta en las estadísticas. Solo marcar: se opera igual y se etiqueta, para comparar.")
float  binSz  = input.float(1.0, "Tamaño de cada nivel del perfil (puntos)", minval = 0.25, step = 0.25, group = gPf)
float  vaPct  = input.float(70, "Área de valor (%)", minval = 50, maxval = 95, group = gPf) / 100.0
bool   showVa = input.bool(true, "Dibujar área de valor y POC de ayer", group = gPf)
color  cVa    = input.color(#E9A23B, "Color del área de valor", group = gPf)

// ───────────── Datos ─────────────
float tick      = syminfo.mintick
float tickValue = syminfo.mintick * syminfo.pointvalue   // ES: 0.25 × 50 = 12.50 USD

// EMA del marco superior sin repintar: valor de la última vela de 3 min ya cerrada
float emaHtf = request.security(syminfo.tickerid, tfEma, ta.ema(close, lenEma)[1], lookahead = barmerge.lookahead_on)
// La EMA cambia de color según el precio esté arriba (zona de compra) o abajo (zona de venta)
color emaCol = close > emaHtf ? cUp : cDn
plot(showEma ? emaHtf : na, "EMA 20 (3 min)", color = emaCol, linewidth = 2)

// Horarios del día de la vela
int yMx  = year(time, TZ_MX)
int moMx = month(time, TZ_MX)
int dMx  = dayofmonth(time, TZ_MX)
int tEntry = timestamp(TZ_MX, yMx, moMx, dMx, hEnt, mEnt)
int yNy  = year(time, TZ_NY)
int moNy = month(time, TZ_NY)
int dNy  = dayofmonth(time, TZ_NY)
int tClose = timestamp(TZ_NY, yNy, moNy, dNy, hCl, mCl)
int dayKey = yMx * 10000 + moMx * 100 + dMx
int nyKey  = yNy * 10000 + moNy * 100 + dNy
int nyMin  = hour(time, TZ_NY) * 60 + minute(time, TZ_NY)
bool inRth = timeframe.isintraday and nyMin >= 570 and nyMin < 960   // sesión regular 9:30–16:00 NY
float barMins = timeframe.in_seconds() / 60.0

bool isEntryBar = timeframe.isintraday and time <= tEntry and tEntry < time_close
bool isCloseBar = time <= tClose and tClose < time_close
int  tPre = tEntry - preMin * 60000
// vela que cierra en (o contiene) el minuto del aviso: con velas de 1 min es la de 9:06, que cierra a las 9:07
bool isPreBar = timeframe.isintraday and time < tPre and tPre <= time_close

// ───────────── Estado de la operación ─────────────
var int   dir      = 0        // 1 compra, -1 venta, 0 sin operación
var float ent      = na
var float sl       = na
var float tp1      = na
var float tp2      = na
var bool  leg1Open = false
var bool  leg2Open = false
var float r1       = 0.0      // resultado de cada pierna en ticks
var float r2       = 0.0
var string why1    = ""
var string why2    = ""
var int   lastDay  = -1
var int   preDay   = -1
var int   preDir   = 0
var int   entBar   = na
var line  lnEnt    = na
var line  lnSl     = na
var line  lnTp1    = na
var line  lnTp2    = na

// Estadísticas acumuladas
var int   nOps   = 0
var int   nWin   = 0
var float gp     = 0.0
var float gl     = 0.0
var int   nTp2   = 0
var int   nBe    = 0
var int   nStop  = 0
var int   nOther = 0
var float lastUsd = na
var string lastOut = ""
var int   nSkip  = 0       // entradas filtradas
var bool  curPass = true   // la operación abierta pasó los filtros
var int   nF     = 0       // estadísticas de las que pasan los filtros
var int   nWinF  = 0
var float gpF    = 0.0
var float glF    = 0.0

// Eventos para alertas
bool evLong  = false
bool evShort = false
bool evTp1   = false
bool evTp2   = false
bool evSl    = false
bool evBe    = false
bool evCl    = false
bool evPreL  = false
bool evPreS  = false
bool evSkip  = false

endLine(line l) =>
    if not na(l)
        line.set_x2(l, bar_index)

// ───────────── Perfil de mercado por tiempo (TPO) ─────────────
// Cada vela reparte un punto entre los niveles de precio que tocó.
addBar(map<int, float> m, float lo, float hi, float bsz) =>
    int a = math.floor(lo / bsz)
    int z = math.floor(hi / bsz)
    float w = 1.0 / (z - a + 1)
    for k = a to z
        float prev = map.get(m, k)
        map.put(m, k, (na(prev) ? 0.0 : prev) + w)
    true

// POC, VAH, VAL y posición del POC dentro del rango (0 = abajo, 1 = arriba)
profileLevels(map<int, float> m, float bsz, float pct) =>
    float poc = na
    float vah = na
    float val = na
    float pos = na
    array<int> ks = map.keys(m)
    if array.size(ks) > 0
        array.sort(ks, order.ascending)
        int k0 = array.get(ks, 0)
        int k1 = array.get(ks, array.size(ks) - 1)
        int nb = k1 - k0 + 1
        array<float> c = array.new<float>(nb, 0.0)
        float tot = 0.0
        for k in ks
            float v = map.get(m, k)
            array.set(c, k - k0, v)
            tot += v
        int p = 0
        for i = 0 to nb - 1
            if array.get(c, i) > array.get(c, p)
                p := i
        int up = p
        int dn = p
        float acc = array.get(c, p)
        while acc < tot * pct
            float a = up + 1 < nb ? array.get(c, up + 1) : -1.0
            float b = dn - 1 >= 0 ? array.get(c, dn - 1) : -1.0
            if a < 0 and b < 0
                break
            if a >= b
                up += 1
                acc += a
            else
                dn -= 1
                acc += b
        poc := (k0 + p) * bsz + bsz / 2
        vah := (k0 + up + 1) * bsz
        val := (k0 + dn) * bsz
        pos := (poc - k0 * bsz) / math.max((k1 + 1 - k0) * bsz, bsz)
    [poc, vah, val, pos]

var map<int, float> mCur = map.new<int, float>()
var float curMins = 0.0
var int   curDay  = -1
var bool  wasRth  = false
var float pPoc = na
var float pVah = na
var float pVal = na
var line  lVah = na
var line  lVal = na
var line  lPoc = na

bool newSess = inRth and nyKey != curDay
bool endSess = (wasRth and not inRth) or (newSess and map.size(mCur) > 0)
if endSess
    if curMins >= 200        // solo sesiones completas
        [q1, q2, q3, q4] = profileLevels(mCur, binSz, vaPct)
        pPoc := q1
        pVah := q2
        pVal := q3
    map.clear(mCur)
    curMins := 0.0
if newSess
    curDay := nyKey
    if showVa and not na(pVah)
        lVah := line.new(bar_index, pVah, bar_index, pVah, color = color.new(cVa, 30), width = 1)
        lVal := line.new(bar_index, pVal, bar_index, pVal, color = color.new(cVa, 30), width = 1)
        lPoc := line.new(bar_index, pPoc, bar_index, pPoc, color = cVa, width = 1, style = line.style_dashed)
        linefill.new(lVah, lVal, color.new(cVa, 90))
        label.new(bar_index, pVah, "Valor de ayer", style = label.style_label_lower_left, color = color.new(cVa, 100), textcolor = cVa, size = size.tiny)
if inRth and showVa
    endLine(lVah)
    endLine(lVal)
    endLine(lPoc)

// Filtros A y C para una entrada en px con dirección d (usa el perfil del día hasta la vela anterior)
filtros(float px, int d) =>
    bool fA = useA and not na(pVah) and px >= pVal and px <= pVah
    bool fC = false
    if useC and curMins >= 20
        [z1, z2, z3, posNow] = profileLevels(mCur, binSz, vaPct)
        float pd = d == 1 ? posNow : 1 - posNow
        fC := pd > 0.62
    [fA, fC]

// Aviso previo: dirección que tendría la entrada si fuera ahora (5 min antes de las 9:12)
if isPreBar and barstate.isconfirmed and dayKey != preDay and not na(emaHtf)
    preDay := dayKey
    preDir := close > emaHtf ? 1 : -1
    evPreL := preDir == 1
    evPreS := preDir == -1
    [pfA, pfC] = filtros(close, preDir)
    string preF = pfA ? "\nfiltro: dentro del valor de ayer" : pfC ? "\nfiltro: perfil " + (preDir == 1 ? "P" : "b") + " a favor" : ""
    if showPre
        string hhmm = str.tostring(hour(tPre, TZ_MX)) + ":" + (minute(tPre, TZ_MX) < 10 ? "0" : "") + str.tostring(minute(tPre, TZ_MX))
        label.new(bar_index, preDir == 1 ? low : high, (preDir == 1 ? "▲ PREVIO COMPRA" : "▼ PREVIO VENTA") + "\n" + hhmm + " CDMX · se confirma a las 9:12" + preF,
             yloc = preDir == 1 ? yloc.belowbar : yloc.abovebar, style = preDir == 1 ? label.style_arrowup : label.style_arrowdown,
             color = preDir == 1 ? cUp : cDn, textcolor = preDir == 1 ? cUp : cDn, size = size.normal)

// Entrada
if isEntryBar and dayKey != lastDay and dir == 0 and not na(emaHtf)
    lastDay := dayKey
    float px = time == tEntry ? open : close
    int dCand = px > emaHtf ? 1 : -1
    [fA, fC] = filtros(px, dCand)
    bool skipIt = fA or fC
    string why = fA ? "dentro del valor de ayer" : fC ? "perfil " + (dCand == 1 ? "P" : "b") + " a favor" : ""
    curPass := not skipIt
    if skipIt
        nSkip += 1
        evSkip := true
    if skipIt and fMode == "Saltar"
        label.new(bar_index, dCand == 1 ? low : high, "SALTADA 9:12 · " + (dCand == 1 ? "compra" : "venta") + "\n" + why,
             style = dCand == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 30), textcolor = color.white, size = size.small)
    else
        dir      := dCand
        ent      := px
        sl       := ent - dir * slT  * tick
        tp1      := ent + dir * tp1T * tick
        tp2      := ent + dir * tp2T * tick
        leg1Open := true
        leg2Open := true
        entBar   := bar_index
        r1       := 0.0
        r2       := 0.0
        why1     := ""
        why2     := ""
        evLong  := dir == 1
        evShort := dir == -1
        lnEnt := line.new(bar_index, ent, bar_index, ent, color = color.new(color.gray, 0), width = 1)
        lnSl  := line.new(bar_index, sl,  bar_index, sl,  color = cDn, width = 1, style = line.style_dashed)
        lnTp1 := line.new(bar_index, tp1, bar_index, tp1, color = color.new(cUp, 30), width = 1, style = line.style_dashed)
        lnTp2 := line.new(bar_index, tp2, bar_index, tp2, color = cUp, width = 1, style = line.style_dashed)
        string conf = preDay == dayKey ? (preDir == dir ? "\nconfirma el previo" : "\ncambió respecto al previo") : ""
        string marca = skipIt ? "\n⚠ filtro: " + why : ""
        label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "COMPRA" : "VENTA") + " 9:12 CDMX\n" + str.tostring(ent, format.mintick) + conf + marca,
             style = dir == 1 ? label.style_label_up : label.style_label_down, color = skipIt ? color.new(color.gray, 20) : dir == 1 ? cUp : cDn, textcolor = color.white, size = size.small)

// Gestión de la operación (incluye la vela de entrada)
if dir != 0
    bool entryNow = bar_index == entBar
    // stop primero: si en la misma vela se tocan stop y objetivo, se cuenta el stop (criterio conservador)
    bool hitSl = dir == 1 ? low <= sl : high >= sl
    if hitSl
        float fill = entryNow ? sl : (dir == 1 ? math.min(open, sl) : math.max(open, sl))
        bool isBe = leg2Open and not leg1Open and sl == ent
        if leg1Open
            r1       := (fill - ent) * dir / tick
            why1     := "SL"
            leg1Open := false
        if leg2Open
            r2       := (fill - ent) * dir / tick
            why2     := isBe ? "BE" : "SL"
            leg2Open := false
        if isBe
            evBe := true
        else
            evSl := true
    else
        if leg1Open and (dir == 1 ? high >= tp1 : low <= tp1)
            r1       := tp1T
            why1     := "TP1"
            leg1Open := false
            evTp1 := true
            line.set_x2(lnTp1, bar_index)
            if useBE and leg2Open
                line.set_x2(lnSl, bar_index)
                sl   := ent
                lnSl := line.new(bar_index, sl, bar_index, sl, color = color.new(color.gray, 20), width = 1, style = line.style_dotted)
        if leg2Open and (dir == 1 ? high >= tp2 : low <= tp2)
            r2       := tp2T
            why2     := "TP2"
            leg2Open := false
            evTp2 := true
    // cierre forzado 15:59 NY
    if (leg1Open or leg2Open) and isCloseBar
        if leg1Open
            r1       := (close - ent) * dir / tick
            why1     := "Cierre"
            leg1Open := false
        if leg2Open
            r2       := (close - ent) * dir / tick
            why2     := "Cierre"
            leg2Open := false
        evCl := true
    endLine(lnEnt)
    endLine(lnSl)
    endLine(lnTp2)
    if leg1Open
        endLine(lnTp1)
    if not leg1Open and not leg2Open
        float usd = (r1 + r2) * qty * tickValue - 2 * qty * (comm + slip * tickValue)
        string outc = why1 == "TP1" and why2 == "TP2" ? "TP1 + TP2" : why1 == "TP1" and why2 == "BE" ? "TP1 + BE" : why1 == "TP1" ? "TP1 + cierre" : why1 == "SL" ? "Stop" : "Cierre"
        nOps += 1
        if usd > 0
            nWin += 1
            gp += usd
        else
            gl -= usd
        if outc == "TP1 + TP2"
            nTp2 += 1
        else if outc == "TP1 + BE"
            nBe += 1
        else if outc == "Stop"
            nStop += 1
        else
            nOther += 1
        lastUsd := usd
        lastOut := outc
        if curPass
            nF += 1
            if usd > 0
                nWinF += 1
                gpF += usd
            else
                glF -= usd
        label.new(bar_index, dir == 1 ? high : low, outc + "\n" + (usd >= 0 ? "+" : "") + str.tostring(usd, "#,##0.00") + " USD",
             style = dir == 1 ? label.style_label_down : label.style_label_up, color = usd > 0 ? color.new(cUp, 20) : color.new(cDn, 20), textcolor = color.white, size = size.small)
        dir := 0

// Se agrega la vela al perfil del día después de evaluar la entrada
if inRth
    addBar(mCur, low, high, binSz)
    curMins += barMins
wasRth := inRth

// ───────────── Tabla ─────────────
var table tb = table.new(position.top_right, 2, 14, bgcolor = color.new(#0F1112, 10), border_color = color.new(color.white, 85), border_width = 1)
if showTable and barstate.islast
    float net = gp - gl
    float pf  = gl > 0 ? gp / gl : na
    string estado = dir == 0 ? "Sin operación" : (dir == 1 ? "Compra" : "Venta") + (leg1Open ? " · 2 contratos" : " · TP1 cobrado, stop en " + (sl == ent ? "BE" : str.tostring(sl, format.mintick)))
    table.cell(tb, 0, 0, "Modelo B · " + str.tostring(slT) + "/" + str.tostring(tp1T) + "/" + str.tostring(tp2T), text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, estado, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Operaciones", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(nOps), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Win rate", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 2, nOps > 0 ? str.tostring(100.0 * nWin / nOps, "0.0") + "%" : "—", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Factor de beneficio", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 3, na(pf) ? "—" : str.tostring(pf, "0.000"), text_color = na(pf) ? color.white : pf >= 1 ? cUp : cDn, text_size = size.small)
    table.cell(tb, 0, 4, "Neto (USD)", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(net, "#,##0"), text_color = net >= 0 ? cUp : cDn, text_size = size.small)
    table.cell(tb, 0, 5, "Expectativa / op", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 5, nOps > 0 ? str.tostring(net / nOps, "#,##0.00") : "—", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 6, "TP1 + TP2 / TP1 + BE", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 6, str.tostring(nTp2) + " / " + str.tostring(nBe), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 7, "Stop / otros cierres", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(nStop) + " / " + str.tostring(nOther), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 8, "Última", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 8, na(lastUsd) ? "—" : lastOut + " · " + str.tostring(lastUsd, "#,##0.00"), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 9, "Costos", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 9, str.tostring(comm, "0.00") + " USD + " + str.tostring(slip) + " tick / contrato", text_color = color.gray, text_size = size.small)
    table.cell(tb, 0, 10, "Aviso previo de hoy", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 10, preDay == dayKey ? (preDir == 1 ? "▲ COMPRA" : "▼ VENTA") : "Pendiente", text_color = preDay == dayKey ? (preDir == 1 ? cUp : cDn) : color.gray, text_size = size.small)
    float pfF = glF > 0 ? gpF / glF : na
    table.cell(tb, 0, 11, "Filtros de perfil", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 11, (useA ? "A" : "") + (useA and useC ? " + " : "") + (useC ? "C" : "") + (useA or useC ? " · " + fMode : "apagados"), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 12, "Entradas filtradas", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 12, str.tostring(nSkip), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 13, "Pasan filtro: ops · win · PF", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 13, nF > 0 ? str.tostring(nF) + " · " + str.tostring(100.0 * nWinF / nF, "0.0") + "% · " + (na(pfF) ? "—" : str.tostring(pfF, "0.00")) : "—",
         text_color = na(pfF) ? color.white : pfF >= 1 ? cUp : cDn, text_size = size.small)

// ───────────── Alertas ─────────────
alertcondition(evLong,  "Modelo B · Compra",       "Modelo B: COMPRA a las 9:12 CDMX en {{ticker}} cerca de {{open}}")
