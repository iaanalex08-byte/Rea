//@version=6
indicator("Rascacielos NQ (9:30 NY)", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// Estrategia "Rascacielos": entrada a la apertura de NY (9:30 ET) a favor de la EMA 20/50 de 15 min,
// TP chico, SL grande y promediado opcional en contra. Cierre 15:55 ET si no toca nada.
// Aviso con flecha N minutos antes (dirección provisional con la vela de 15 min en curso).
// Ojo: en el backtest 2024-2026 ninguna versión tuvo ventaja; úsalo para seguirla, no como plan.
// Usar en MNQ1!/NQ1! en 1, 2, 3 o 5 minutos.
// Escrito sin bloques con sangría para que el editor de TradingView en el celular no lo descomponga al pegar.

tzNY = "America/New_York"
g1 = "Reglas"
modo = input.string("A favor de las EMAs", "Dirección", options=["A favor de las EMAs", "Al revés"], group=g1)
tpPts = input.float(10, "TP (pts desde el precio promedio)", minval=0.25, step=0.25, group=g1)
slPts = input.float(700, "SL (pts desde la primera entrada)", minval=1, step=0.25, group=g1)
promed = input.string("Sin promediar", "Promediado en contra", options=["Sin promediar", "2 iguales (+1 a 1/3 y 2/3 del SL)", "Martingala (+2 a 1/3, +4 a 2/3)"], group=g1)
qty0 = input.int(1, "Contratos iniciales", minval=1, group=g1)
pv = input.float(2.0, "$ por punto por contrato (MNQ = 2, NQ = 20)", minval=0.01, group=g1)
eH = input.int(9, "Hora de entrada (NY)", minval=0, maxval=23, group=g1)
eM = input.int(30, "Minuto de entrada (NY)", minval=0, maxval=59, group=g1)
cH = input.int(15, "Hora de cierre (NY)", minval=0, maxval=23, group=g1)
cM = input.int(55, "Minuto de cierre (NY)", minval=0, maxval=59, group=g1)
preMin = input.int(5, "Aviso anticipado (minutos antes de la entrada)", minval=0, maxval=60, tooltip="0 = sin aviso. Con 5 la flecha sale a las 9:25 NY", group=g1)
gV = "Vista"
showEma = input.bool(true, "Mostrar EMA 20 y 50 de 15 min", group=gV)
showBox = input.bool(true, "Mostrar cajas de TP y SL", group=gV)
extBars = input.int(60, "Largo de las cajas (velas)", minval=5, maxval=400, group=gV)
cUp = input.color(color.new(#089981, 0), "Compra", group=gV)
cDown = input.color(color.new(#f23645, 0), "Venta", group=gV)

// EMAs de 15 min: cerradas (para entrar) y en curso (para el aviso)
e20 = request.security(syminfo.tickerid, "15", ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
e50 = request.security(syminfo.tickerid, "15", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
e20v = request.security(syminfo.tickerid, "15", ta.ema(close, 20))
e50v = request.security(syminfo.tickerid, "15", ta.ema(close, 50))
plot(showEma ? e20 : na, "EMA 20 (15m)", color=color.new(color.orange, 20))
plot(showEma ? e50 : na, "EMA 50 (15m)", color=color.new(color.blue, 20))

tNY = hour(time, tzNY) * 60 + minute(time, tzNY)
tfMin = timeframe.in_seconds() / 60
entryMin = eH * 60 + eM
closeMin = cH * 60 + cM
avisoMin = entryMin - preMin
newDay = dayofmonth(time, tzNY) != dayofmonth(time[1], tzNY)
f1 = 1.0 / 3.0
f2 = 2.0 / 3.0
add1 = promed == "Sin promediar" ? 0 : promed == "2 iguales (+1 a 1/3 y 2/3 del SL)" ? 1 : 2
add2 = promed == "Sin promediar" ? 0 : promed == "2 iguales (+1 a 1/3 y 2/3 del SL)" ? 1 : 4
usd(float v) => (v < 0 ? "-$" : "$") + str.tostring(math.abs(v), "#,##0.00")

var int side = 0
var bool done = false
var bool avisado = false
var float e0 = na
var float slLvl = na
var float a1Lvl = na
var float a2Lvl = na
var int qty = 0
var float avg = na
var bool did1 = false
var bool did2 = false
var box bTp = na
var box bSl = na
var line lA1 = na
var line lA2 = na
var int wins = 0
var int losses = 0
var float net = 0.0
var string estado = "Esperando 9:30 NY"

// Nuevo día: se reinicia
side := newDay ? 0 : side
done := newDay ? false : done
avisado := newDay ? false : avisado
qty := newDay ? 0 : qty

// Aviso anticipado: flecha en la vela que contiene la hora de aviso (9:25 NY por defecto)
dirAviso0 = e20v > e50v ? 1 : -1
dirAviso = modo == "A favor de las EMAs" ? dirAviso0 : -dirAviso0
isAviso = preMin > 0 and not avisado and side == 0 and not done and tNY <= avisoMin and avisoMin < tNY + tfMin and not na(e20v) and not na(e50v)
avisado := isAviso ? true : avisado
preBuy = isAviso and dirAviso == 1
preSell = isAviso and dirAviso == -1

// Entrada a mercado a la apertura de la vela de las 9:30 NY
isEntry = not done and side == 0 and tNY == entryMin and not na(e20) and not na(e50) and e20 != e50
dirEma = e20 > e50 ? 1 : -1
side := isEntry ? (modo == "A favor de las EMAs" ? dirEma : -dirEma) : side
e0 := isEntry ? math.round_to_mintick(open) : e0
qty := isEntry ? qty0 : qty
avg := isEntry ? e0 : avg
did1 := isEntry ? false : did1
did2 := isEntry ? false : did2
slLvl := isEntry ? math.round_to_mintick(e0 - side * slPts) : slLvl
a1Lvl := isEntry ? (add1 > 0 ? e0 - side * f1 * slPts : na) : a1Lvl
a2Lvl := isEntry ? (add2 > 0 ? e0 - side * f2 * slPts : na) : a2Lvl
tp0 = e0 + side * tpPts
buySig = isEntry and side == 1
sellSig = isEntry and side == -1
lblEntrada = isEntry ? label.new(bar_index, e0, (side == 1 ? "COMPRA" : "VENTA") + " MKT @ " + str.tostring(e0, format.mintick), style=side == 1 ? label.style_label_up : label.style_label_down, color=side == 1 ? cUp : cDown, textcolor=color.white, size=size.small) : na
bTp := isEntry and showBox ? box.new(bar_index, math.max(e0, tp0), bar_index + extBars, math.min(e0, tp0), border_color=cUp, border_style=line.style_dashed, bgcolor=color.new(#089981, 75)) : bTp
bSl := isEntry and showBox ? box.new(bar_index, math.max(e0, slLvl), bar_index + extBars, math.min(e0, slLvl), border_color=cDown, border_style=line.style_dashed, bgcolor=color.new(#f23645, 75)) : bSl
lblTp = isEntry and showBox ? label.new(bar_index + extBars, tp0, "TP " + str.tostring(tp0, format.mintick) + " (" + str.tostring(tpPts) + " pts)", style=label.style_label_left, color=cUp, textcolor=color.white, size=size.tiny) : na
lblSl = isEntry and showBox ? label.new(bar_index + extBars, slLvl, "SL " + str.tostring(slLvl, format.mintick) + " (" + str.tostring(slPts) + " pts)", style=label.style_label_left, color=cDown, textcolor=color.white, size=size.tiny) : na
lA1 := isEntry and add1 > 0 ? line.new(bar_index, a1Lvl, bar_index + extBars, a1Lvl, color=color.new(color.gray, 30), style=line.style_dotted) : lA1
lA2 := isEntry and add2 > 0 ? line.new(bar_index, a2Lvl, bar_index + extBars, a2Lvl, color=color.new(color.gray, 30), style=line.style_dotted) : lA2

// Promediado en contra
inPos = side != 0 and not done
hit1 = inPos and add1 > 0 and not did1 and (side == 1 ? low <= a1Lvl : high >= a1Lvl)
avg := hit1 ? (avg * qty + a1Lvl * add1 * qty0) / (qty + add1 * qty0) : avg
qty := hit1 ? qty + add1 * qty0 : qty
did1 := hit1 ? true : did1
hit2 = inPos and add2 > 0 and not did2 and (side == 1 ? low <= a2Lvl : high >= a2Lvl)
avg := hit2 ? (avg * qty + a2Lvl * add2 * qty0) / (qty + add2 * qty0) : avg
qty := hit2 ? qty + add2 * qty0 : qty
did2 := hit2 ? true : did2

// Salida: cierre 15:55, SL o TP (si una vela toca los dos se toma el SL)
tpLvl = avg + side * tpPts
box.set_top(bTp, inPos ? math.max(e0, tpLvl) : box.get_top(bTp))
box.set_bottom(bTp, inPos ? math.min(e0, tpLvl) : box.get_bottom(bTp))
isClose = inPos and tNY >= closeMin
isSL = inPos and not isClose and (side == 1 ? low <= slLvl : high >= slLvl)
isTP = inPos and not isClose and not isSL and (side == 1 ? high >= tpLvl : low <= tpLvl)
exitPx = isClose ? open : isSL ? slLvl : isTP ? tpLvl : na
res = na(exitPx) ? na : (exitPx - avg) * side * qty * pv - 1.74 * qty
lblSalida = not na(res) ? label.new(bar_index, exitPx, (isClose ? "⏱ CIERRE 15:55 " : isSL ? "✖ PERDIDA " : "✔ GANADA ") + usd(res), style=isSL ? (side == 1 ? label.style_label_up : label.style_label_down) : (side == 1 ? label.style_label_down : label.style_label_up), color=isClose ? color.gray : res >= 0 ? cUp : cDown, textcolor=color.white, size=size.small) : na
net := net + nz(res)
wins := wins + (not na(res) and res > 0 ? 1 : 0)
losses := losses + (not na(res) and res <= 0 ? 1 : 0)
done := not na(res) ? true : done

// Estado del día
estado := newDay ? "Esperando 9:30 NY" : estado
estado := isAviso ? "AVISO: a las 9:30 toca " + (dirAviso == 1 ? "COMPRA" : "VENTA") : estado
estado := isEntry ? (side == 1 ? "COMPRA" : "VENTA") + " abierta" : estado
estado := not na(res) ? (res > 0 ? "Ganada " : "Perdida ") + usd(res) : estado

// Flechas
plotshape(preBuy, "Aviso compra", shape.arrowup, location.belowbar, cUp, size=size.large, text="AVISO\nCOMPRA")
plotshape(preSell, "Aviso venta", shape.arrowdown, location.abovebar, cDown, size=size.large, text="AVISO\nVENTA")
plotshape(buySig, "Entrada compra", shape.triangleup, location.belowbar, cUp, size=size.small, text="BUY")
plotshape(sellSig, "Entrada venta", shape.triangledown, location.abovebar, cDown, size=size.small, text="SELL")

// Alertas: crea una alerta con cada condición
alertcondition(preBuy or preSell, "Aviso Rascacielos", "Rascacielos: en 5 min entrada en {{ticker}} (revisa la flecha: COMPRA o VENTA)")
alertcondition(preBuy, "Aviso COMPRA", "Rascacielos: en 5 min toca COMPRA en {{ticker}}")
alertcondition(preSell, "Aviso VENTA", "Rascacielos: en 5 min toca VENTA en {{ticker}}")
alertcondition(isEntry, "Entrada Rascacielos", "Rascacielos: entrada a mercado 9:30 NY en {{ticker}} a {{open}}")
alertcondition(hit1 or hit2, "Promedia Rascacielos", "Rascacielos: entra el promediado en {{ticker}}")
alertcondition(not na(res), "Cierre Rascacielos", "Rascacielos: operación cerrada en {{ticker}}")

// Tabla
var table tb = table.new(position.top_right, 2, 8, bgcolor=color.new(#1e222d, 0), border_width=1, border_color=color.new(color.gray, 60))
dirNow = na(e20v) or na(e50v) ? "—" : (dirAviso == 1 ? "COMPRA" : "VENTA")
table.cell(tb, 0, 0, "Rascacielos hoy", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 0, estado, text_color=color.yellow)
table.cell(tb, 0, 1, "Dirección según EMAs (ahora)", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 1, dirNow, text_color=dirNow == "COMPRA" ? cUp : cDown)
table.cell(tb, 0, 2, "Contratos ahora / precio prom.", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 2, side != 0 and not done ? str.tostring(qty) + " / " + str.tostring(avg, format.mintick) : "—", text_color=color.white)
table.cell(tb, 0, 3, "Ganadas / perdidas", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 3, str.tostring(wins) + " / " + str.tostring(losses), text_color=color.white)
table.cell(tb, 0, 4, "Neto (en el gráfico)", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 4, usd(net), text_color=net >= 0 ? cUp : cDown)
table.cell(tb, 0, 5, "Por día: gana / pierde", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 5, usd(tpPts * pv * qty0 - 1.74 * qty0) + " / " + usd(-(slPts * pv * qty0 * (1 + add1 * f2 + add2 * f1)) - 1.74 * qty0 * (1 + add1 + add2)), text_color=color.white)
table.cell(tb, 0, 6, "% acierto (en el gráfico)", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 6, wins + losses > 0 ? str.tostring(100.0 * wins / (wins + losses), "#.#") + " %" : "—", text_color=color.white)
table.cell(tb, 0, 7, "TP / SL (backtest: 93 % con 10 / 700)", text_color=color.white, text_halign=text.align_left)
table.cell(tb, 1, 7, str.tostring(tpPts) + " / " + str.tostring(slPts) + " pts", text_color=color.yellow)
